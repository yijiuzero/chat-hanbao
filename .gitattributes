# 强制 shell 脚本与 fpk 配置使用 LF 行尾。
# Windows 下若被转成 CRLF，飞牛(Linux)执行会报 bad interpreter: /bin/bash^M
*.sh            text eol=lf
fpk/cmd/*       text eol=lf
fpk/manifest    text eol=lf
fpk/config/*    text eol=lf
fpk/app/ui/*    text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf

# 二进制文件不做转换
*.png           binary
*.fpk           binary
*.tar           binary
*.tar.gz        binary
*.exe           binary
