# [hanbao modification] I-004: removed the desktop stack (dbus / xvfb / xfce4)
# that only existed to host Chromium browser automation. hanbao is a headless
# chat server; the Web Console is static assets served by FastAPI, so no
# virtual display or desktop environment is required.
[supervisord]
user=root
logfile=/var/log/supervisord.log
pidfile=/var/log/supervisord.pid
nodaemon=true

[program:app]
command=qwenpaw app --host 0.0.0.0 --port ${QWENPAW_PORT}
autostart=true
autorestart=unexpected
startretries=5
startsecs=10
priority=30
stopwaitsecs=30
stderr_logfile=/var/log/app.err.log
stdout_logfile=/var/log/app.out.log
environment=QWENPAW_RUNNING_IN_CONTAINER="1"
