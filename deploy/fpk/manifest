# ============================================================
# 飞牛 FPK 应用清单（manifest）— INI 格式，key=value
# 官方规范: https://developer.fnnas.com/docs/core-concepts/manifest/
# 形态: native（飞牛按 config/resource 的 data-share 声明把本应用视为 native 应用，
#       容器启停/重启/升级由 cmd/main 自行负责）
# 离线镜像: 内置 hanbao-amd64.tar，cmd/main start 时 docker load，compose pull_policy: never
# 来源: 派生自 QwenPaw v2.1.0 (Apache-2.0)，二次开发 hanbao
# ============================================================

appname=hanbao
version=0.1.0
display_name=hanbao
desc=飞牛 NAS 上的私人 AI 聊天助手（微信 + OneBot 渠道）。本地运行、数据自控，仅依赖云端 OpenAI 兼容 API。
source=thirdparty
platform=x86

maintainer=泽零 / Zeling
maintainer_url=https://github.com/yijiuzero/chat-hanbao

os_min_version=1.2.0

desktop_uidir=ui
desktop_applaunchname=hanbao.main

service_port=8088
checkport=true
ctl_stop=true

changelog=首个飞牛 NAS 版本（v0.1.0）。本地运行的私人 AI 聊天助手，数据自控、仅依赖云端 OpenAI 兼容 API。\n- 支持微信 + OneBot 渠道接入\n- 离线内嵌镜像，安装无需外网拉取\n- 默认开启访问认证，首启自动建管理员账号\n- 对话与配置持久化于应用数据卷
