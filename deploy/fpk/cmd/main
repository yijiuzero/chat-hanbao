#!/bin/sh
# ============================================================
# hanbao FPK docker-project 形态生命周期控制器
#
# 飞牛按 config/resource 的 docker-project 声明自动管理容器启停/重启/升级，
# 因此本脚本 start/stop 无需操作（exit 0），仅 status 探测容器运行状态。
# 镜像由 install_callback 预载（docker load 内置 tar，配合 compose pull_policy:never
# 实现离线运行，不依赖外部镜像仓库）。
# ============================================================

CONTAINER_NAME="hanbao"

is_running() {
  docker inspect "${CONTAINER_NAME}" 2>/dev/null | grep -q '"Status": "running"'
}

case "${1:-start}" in
  start)
    # 容器由飞牛 docker-project 机制启动，此处无需操作
    exit 0
    ;;
  stop)
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
    ;;
esac
