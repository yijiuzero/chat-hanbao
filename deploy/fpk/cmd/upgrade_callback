#!/bin/sh
# ============================================================
# hanbao FPK 升级回调（upgrade_callback）
#
# 飞牛在"升级后"调用本脚本。升级时 app/docker 被新包覆盖，需重建凭据文件。
# 优先从 TRIM_PKGETC 持久备份恢复；否则生成最小默认 env，避免 compose 因
# env_file 缺失而失败。本应用为 native 形态，离线镜像由 cmd/main 在启动时 load。
# 不做 set -e，任何异常仅告警不中断升级。
# ============================================================

write_default_env() {
  target="$1"
  mkdir -p "$(dirname "$target")" 2>/dev/null
  {
    echo "# hanbao FPK 升级后默认凭据（备份丢失或 TRIM_PKGETC 未注入）"
    echo "HANBAO_AUTH_ENABLED=true"
  } > "$target" 2>/dev/null
  if [ -f "$target" ]; then
    echo "[hanbao] 已生成默认凭据 $target"
  else
    echo "[hanbao][warn] 默认凭据写入失败：$target" >&2
  fi
}

copy_or_default() {
  target="$1"
  backup="$2"
  mkdir -p "$(dirname "$target")" 2>/dev/null
  if [ -n "$backup" ] && [ -f "$backup" ]; then
    cp -f "$backup" "$target" 2>/dev/null && echo "[hanbao] 已从 $backup 恢复凭据到 $target"
  else
    write_default_env "$target"
  fi
}

# 主目标
if [ -n "${TRIM_APPDEST:-}" ]; then
  copy_or_default "${TRIM_APPDEST}/docker/hanbao.env" "${TRIM_PKGETC:-}/hanbao.env"
fi

# 兜底绝对路径
for fallback in \
  "/vol1/@appcenter/hanbao/docker/hanbao.env" \
  "/vol2/@appcenter/hanbao/docker/hanbao.env" \
  "/vol1/@appconf/hanbao/docker/hanbao.env" \
  "/vol2/@appconf/hanbao/docker/hanbao.env"
do
  parent="$(dirname "$fallback")"
  grandparent="$(dirname "$parent")"
  if [ -d "$parent" ] || [ -d "$grandparent" ]; then
    copy_or_default "$fallback" "${TRIM_PKGETC:-}/hanbao.env"
  fi
done

exit 0
