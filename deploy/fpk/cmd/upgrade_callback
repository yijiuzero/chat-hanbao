#!/bin/sh
# ============================================================
# hanbao FPK 升级回调（upgrade_callback）
#
# 飞牛在"升级后"调用本脚本。升级时 app/docker 被新包覆盖，需重建凭据软链
# （持久凭据文件 TRIM_PKGETC/hanbao.env 不受影响）。离线镜像由 fnOS 自动 reload。
# 不做 set -e，任何异常仅告警不中断升级。
# ============================================================

APP_DEST="${TRIM_APPDEST:-}"
PKG_ETC="${TRIM_PKGETC:-}"

ENV_FILE="${PKG_ETC}/hanbao.env"
ENV_LINK="${APP_DEST}/docker/hanbao.env"

if [ -n "${PKG_ETC}" ] && [ -n "${APP_DEST}" ] && [ -f "${ENV_FILE}" ]; then
  rm -f "${ENV_LINK}" 2>/dev/null
  ln -s "${ENV_FILE}" "${ENV_LINK}" 2>/dev/null
  echo "[hanbao] 已重建凭据软链 ${ENV_LINK} -> ${ENV_FILE}"
fi

exit 0
