#!/bin/sh
# ============================================================
# hanbao FPK 安装回调（install_callback）
#
# 飞牛在完成安装向导后调用本脚本。向导字段以同名环境变量传入（无 TRIM_ 前缀）：
#   HANBAO_AUTH_USERNAME / HANBAO_AUTH_PASSWORD
#
# 本脚本把向导收集的管理员凭据写入 app/docker/hanbao.env，供 compose 通过
# env_file: ./hanbao.env 注入容器。接 I-007 默认开认证 + auto_register_from_env
# 首启自动建管理员账号，消除局域网抢注窗口。用户留空则不写用户名/密码，走首启注册页。
#
# 本应用为 native 形态，容器启停由 cmd/main 自行负责；install_callback 只写凭据、不碰 docker。
# 为兼容真实环境，本脚本不做 set -e：任何异常仅告警，绝不中断安装。
# ============================================================

write_env() {
  target="$1"
  mkdir -p "$(dirname "$target")" 2>/dev/null
  {
    echo "# hanbao FPK 安装向导注入的凭据（install_callback 生成，勿手改）"
    echo "HANBAO_AUTH_ENABLED=true"
    if [ -n "${HANBAO_AUTH_USERNAME:-}" ]; then
      echo "HANBAO_AUTH_USERNAME=${HANBAO_AUTH_USERNAME}"
    fi
    if [ -n "${HANBAO_AUTH_PASSWORD:-}" ]; then
      echo "HANBAO_AUTH_PASSWORD=${HANBAO_AUTH_PASSWORD}"
    fi
  } > "$target" 2>/dev/null
  if [ -f "$target" ]; then
    echo "[hanbao] 凭据已写入 $target"
    return 0
  else
    echo "[hanbao][warn] 凭据写入失败：$target" >&2
    return 1
  fi
}

# 主目标：TRIM_APPDEST/app/docker/hanbao.env（native 形态下 app/docker/ 的落地路径）
if [ -n "${TRIM_APPDEST:-}" ]; then
  write_env "${TRIM_APPDEST}/docker/hanbao.env"
fi

# 兜底：直接写飞牛实际映射的绝对路径（兼容变量未注入的情况）
for fallback in \
  "/vol1/@appcenter/hanbao/docker/hanbao.env" \
  "/vol2/@appcenter/hanbao/docker/hanbao.env" \
  "/vol1/@appconf/hanbao/docker/hanbao.env" \
  "/vol2/@appconf/hanbao/docker/hanbao.env"
do
  parent="$(dirname "$fallback")"
  grandparent="$(dirname "$parent")"
  if [ -d "$parent" ] || [ -d "$grandparent" ]; then
    write_env "$fallback"
  fi
done

# 若 TRIM_PKGETC 存在，额外复制一份到持久目录，供升级时恢复
if [ -n "${TRIM_PKGETC:-}" ]; then
  mkdir -p "${TRIM_PKGETC}" 2>/dev/null
  if [ -n "${TRIM_APPDEST:-}" ] && [ -f "${TRIM_APPDEST}/docker/hanbao.env" ]; then
    cp -f "${TRIM_APPDEST}/docker/hanbao.env" "${TRIM_PKGETC}/hanbao.env" 2>/dev/null \
      && echo "[hanbao] 凭据已备份到 ${TRIM_PKGETC}/hanbao.env"
  fi
fi

exit 0
