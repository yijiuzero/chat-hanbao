# Git and IDE
.git
.gitignore
.idea
.vscode
*.md
!README.md

# Python dev and cache
__pycache__
*.py[cod]
*$py.class
.venv
venv
uv.lock
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache

# Tests (not needed in runtime image)
tests
test.py
*_test.py
pytest.ini
.pre-commit-config.yaml
.flake8
.eslintrc
.stylelintrc

# Frontend: exclude build artifacts; ship pre-built src/console/dist in image
website
!website/
!website/public/
!website/public/docs/
!website/public/docs/**
console/node_modules
console/dist
console/.vite
node_modules
**/node_modules
**/dist
!src/qwenpaw/console/dist
!src/qwenpaw/console/dist/**
**/.vite

# Example and local config (mount at runtime instead)
example
config.json
jobs.json
sessions_mount_dir

# Misc
.env
.env.*
!.env.example
.DS_Store
*.log
logs
cookbook

# [hanbao modification] keep license compliance artifacts in build context (I-003)
# The `*.md` rule above would otherwise exclude these required files, causing
# the COPY in deploy/Dockerfile (I-002) to fail with "file not found".
!LICENSE
!NOTICE
!docs/CHANGES-FROM-UPSTREAM.md
!docs/license-compliance.md
