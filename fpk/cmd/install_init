#!/bin/bash

### This script is called before the user installs the application.
### 注意：此刻 fpk 内容尚未解压，不能在这里加载内嵌镜像（见 install_callback）。
### 这里只做环境前置检查并写日志，方便排查。

LOG="/var/log/chat-hanbao-install.log"
log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [pre-install] $*"
    echo "$msg"
    echo "$msg" >>"$LOG" 2>/dev/null || echo "$msg" >>/tmp/chat-hanbao-install.log 2>/dev/null
}

log "=== chat-hanbao 安装前检查 ==="
if command -v docker >/dev/null 2>&1; then
    log "docker 版本：$(docker --version 2>&1)"
else
    log "警告：未检测到 docker 命令"
fi
log "可用磁盘：$(df -h /var 2>/dev/null | tail -1)"

exit 0
