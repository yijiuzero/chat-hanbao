#!/bin/bash
# Chat Hanbao - 飞牛 FPK 生命周期控制脚本
# 用法: main <start|stop|restart|status|install|uninstall>

set -e

# 应用信息
APP_NAME="chat-hanbao"
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DOCKER_COMPOSE="docker compose"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 检查 Docker 是否可用
check_docker() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker 未安装"
        exit 1
    fi
    
    if ! docker info &> /dev/null; then
        log_error "Docker 守护进程未运行"
        exit 1
    fi
}

# 启动应用
do_start() {
    log_info "启动 ${APP_NAME}..."
    check_docker
    
    cd "${APP_DIR}/app/docker"
    
    # 拉取最新镜像
    log_info "拉取 Docker 镜像..."
    ${DOCKER_COMPOSE} pull
    
    # 启动服务
    log_info "启动容器..."
    ${DOCKER_COMPOSE} up -d
    
    # 等待服务就绪
    log_info "等待服务就绪..."
    sleep 5
    
    # 检查状态
    if do_status; then
        log_info "${APP_NAME} 启动成功！"
        log_info "前端访问: http://localhost:8373"
        log_info "API 文档: http://localhost:8399/docs"
    else
        log_error "${APP_NAME} 启动失败，请检查日志"
        exit 1
    fi
}

# 停止应用
do_stop() {
    log_info "停止 ${APP_NAME}..."
    check_docker
    
    cd "${APP_DIR}/app/docker"
    ${DOCKER_COMPOSE} down
    
    log_info "${APP_NAME} 已停止"
}

# 重启应用
do_restart() {
    log_info "重启 ${APP_NAME}..."
    do_stop
    sleep 2
    do_start
}

# 检查应用状态
do_status() {
    check_docker
    
    cd "${APP_DIR}/app/docker"
    
    # 检查容器状态
    local running=$(${DOCKER_COMPOSE} ps --format json 2>/dev/null | grep -c '"State":"running"' || echo "0")
    local total=$(${DOCKER_COMPOSE} ps --format json 2>/dev/null | grep -c '"Name"' || echo "0")
    
    if [ "$running" -eq "$total" ] && [ "$total" -gt 0 ]; then
        log_info "运行中 (${running}/${total} 容器运行)"
        return 0
    elif [ "$running" -gt 0 ]; then
        log_warn "部分运行 (${running}/${total} 容器运行)"
        return 1
    else
        log_warn "已停止"
        return 1
    fi
}

# 安装初始化
do_install() {
    log_info "安装 ${APP_NAME}..."
    check_docker
    
    # 创建数据目录
    mkdir -p "${APP_DIR}/app/docker/data/postgres"
    mkdir -p "${APP_DIR}/app/docker/data/redis"
    mkdir -p "${APP_DIR}/app/docker/logs"
    
    log_info "安装完成，请运行 'main start' 启动应用"
}

# 卸载清理
do_uninstall() {
    log_info "卸载 ${APP_NAME}..."
    check_docker
    
    cd "${APP_DIR}/app/docker"
    ${DOCKER_COMPOSE} down -v 2>/dev/null || true
    
    log_info "卸载完成"
}

# 查看日志
do_logs() {
    check_docker
    cd "${APP_DIR}/app/docker"
    ${DOCKER_COMPOSE} logs -f --tail=100
}

# 主入口
case "${1}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_restart
        ;;
    status)
        do_status
        ;;
    install)
        do_install
        ;;
    uninstall)
        do_uninstall
        ;;
    logs)
        do_logs
        ;;
    *)
        echo "用法: $0 <start|stop|restart|status|install|uninstall|logs>"
        echo ""
        echo "命令说明:"
        echo "  start     启动应用"
        echo "  stop      停止应用"
        echo "  restart   重启应用"
        echo "  status    查看状态"
        echo "  install   初始化安装"
        echo "  uninstall 卸载清理"
        echo "  logs      查看日志"
        exit 1
        ;;
esac
