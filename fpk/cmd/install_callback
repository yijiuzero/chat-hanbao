#!/bin/bash

### This script is called after the user installs the application.
### 此时 fpk 内容已解压落地，可以安全加载内嵌的 docker 镜像。
### 飞牛 NAS 没有自动导入 docker 镜像的机制，必须由应用自己 load。

CH_LOG="/var/log/chat-hanbao-install.log"

ch_log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [install] $*"
    echo "$msg"
    { echo "$msg" >>"$CH_LOG"; } 2>/dev/null || echo "$msg" >>/tmp/chat-hanbao-install.log 2>/dev/null
}

ch_find_image_dir() {
    local d
    for d in \
        "${TRIM_APPDEST}/docker/images" \
        "${TRIM_APPDEST}/app/docker/images" \
        "/var/apps/chat-hanbao/app/docker/images" \
        "/var/apps/chat-hanbao/docker/images" \
        "/var/packages/chat-hanbao/app/docker/images" \
        "/var/packages/chat-hanbao/docker/images"
    do
        [ -n "$d" ] || continue
        if ls "$d"/*.tar.gz "$d"/*.tar >/dev/null 2>&1; then
            echo "$d"; return 0
        fi
    done
    d=$(find /var/apps /var/packages -maxdepth 6 -type d -name images -path '*chat-hanbao*' 2>/dev/null | head -1)
    [ -n "$d" ] && { echo "$d"; return 0; }
    return 1
}

ch_log "=== chat-hanbao 离线镜像加载开始 ==="
ch_log "TRIM_APPDEST=${TRIM_APPDEST}"

if ! command -v docker >/dev/null 2>&1; then
    ch_log "错误：找不到 docker 命令，无法加载离线镜像"
    exit 0
fi

IMG_DIR=$(ch_find_image_dir)
if [ -z "$IMG_DIR" ]; then
    ch_log "错误：未找到内嵌镜像目录（已尝试 TRIM_APPDEST 及 /var/apps /var/packages）"
    exit 0
fi
ch_log "找到镜像目录：$IMG_DIR"

for f in "$IMG_DIR"/*.tar.gz "$IMG_DIR"/*.tar; do
    [ -e "$f" ] || continue
    ch_log "正在加载：$f ($(du -h "$f" 2>/dev/null | cut -f1))"
    if docker load -i "$f" >>"$CH_LOG" 2>&1; then
        ch_log "  -> 加载成功"
    elif gunzip -c "$f" 2>/dev/null | docker load >>"$CH_LOG" 2>&1; then
        ch_log "  -> 加载成功（gunzip 管道方式）"
    else
        ch_log "  -> 加载失败：$f"
    fi
done

ch_log "当前 chat-hanbao 相关镜像："
docker images --format '  {{.Repository}}:{{.Tag}}  {{.Size}}' 2>/dev/null | grep chat-hanbao >>"$CH_LOG" 2>&1

ch_log "=== 离线镜像加载结束 ==="

# 即使加载失败也不阻断安装，让用户能进去看日志排查
exit 0
